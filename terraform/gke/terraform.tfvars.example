gcp_project_id     = "YOUR_GCP_PROJECT_ID"
gcp_region         = "us-central1"
cluster_name       = "vllm-ephemeral-gke"
node_machine_type  = "e2-standard-4"
use_spot_instances = true

# HAMI GPU demo settings
hami_gpu_machine_type       = "n1-standard-4"
hami_gpu_accelerator_type   = "nvidia-tesla-t4"
hami_gpu_accelerator_count  = 1
hami_gpu_pool_initial_count = 1
hami_gpu_pool_min_count     = 1
hami_gpu_pool_max_count     = 1

# Optional tuning
node_pool_min_count  = 1
node_pool_max_count  = 4