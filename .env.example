# ==============================================================================
# vLLM Inference Platform - Environment Configuration Template
# Copy this file to .env before starting docker-compose:
#   cp .env.example .env
# ==============================================================================

# LLM Model Configuration (Lightweight CPU targets)
# Recommended options:
# - Qwen/Qwen2.5-0.5B-Instruct (Default, ~1GB RAM)
# - meta-llama/Llama-3.2-1B-Instruct (~2.5GB RAM)
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MAX_MODEL_LEN=2048
# CPU-optimized vLLM image for local/WSL use
VLLM_IMAGE=public.ecr.aws/q9t5s3a7/vllm-cpu-release-repo:latest

# Networking & Port Bindings
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
VLLM_HOST_PORT=8002
PROMETHEUS_PORT=9090
OTEL_COLLECTOR_PORT=4318

# vLLM CPU Optimization Settings
# Match OMP_NUM_THREADS to available physical CPU cores
OMP_NUM_THREADS=4
# Space in GiB reserved for CPU KV cache
VLLM_CPU_KVCACHE_SPACE=4

# Gateway Security & Authentication
API_KEY=secret-api-key
